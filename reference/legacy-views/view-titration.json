mber') }} mL</td>\n        </tr>\n        <tr>\n            <th>Volume total</th>\n            <td>{{ rendertype(totalVolume, {toPrecision: 4}, 'number') }} mL</td>\n        </tr>\n        <tr>\n            <th style=\"font-size: 1.5em\">pH</th>\n            <td style=\"font-size: 1.5em\">{{ rendertype(pH, {numeral: '0.00'}, 'number') }}</td>\n        </tr>\n        {% if trackColor.color %}\n        <tr>\n            <th>Couleur indicateur</th>\n            <td>\n                <div style=\"background-color: {{trackColor.color}}; width:100px; height: 20px\"></div>\n            </td>\n        </tr>\n        {% endif %}\n    </table>\n</div>\n\n<p>&nbsp;</p>\n<div id=\"resultDetails\">\n    <table>\n        <tr>\n            <th>Espèce</th>\n            <th style=\"width: 100px;\">[]</th>\n            <th style=\"width: 100px;\">-log[]</th>\n        </tr>\n        {% for key in result.species %}\n            {% set logValue = result.solutions[idx][key] | math_log10 %}\n            <tr>\n                <td>{{ rendertype(result.speciesNew[loop.index0],'mf') }}</td>\n                <td>{{ rendertype(result.solutions[idx][key], {toPrecision: 4}, 'number') }}</td>\n                <td>{{ rendertype(-1 * logValue, {numeral: '0.00'}, 'number') }}</td>\n            </tr>\n        {% endfor %}\n    </table>\n    \n    \n</div>"]}],"ace":[{"useSoftTabs":[["yes"]],"tabSize":[4]}]}},"layers":{"Default layer":{"position":{"left":0,"top":0},"size":{"width":20,"height":20},"zIndex":0,"display":false,"title":"","bgColor":[255,255,255,0],"wrapper":true,"created":true,"name":"Default layer"},"Admin":{"position":{"left":0,"top":0},"size":{"width":20,"height":20},"zIndex":0,"display":false,"title":"","bgColor":[255,255,255,0],"wrapper":true,"created":true,"name":"Admin"},"Twig":{"position":{"left":3,"top":5},"size":{"width":79,"height":34},"zIndex":0,"display":true,"title":"","bgColor":[255,255,255,0],"wrapper":true,"created":true,"name":"Twig"},"Actions":{"position":{"left":0,"top":