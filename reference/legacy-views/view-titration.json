 var el = {};\n            indicatorTable.push(el);\n            \n            var stopPositions = [];\n            var stopColors = [];\n            for(var i=0; i<groupedInd.length; i++) {\n                stopPositions.push(groupedInd[i].pH1);\n                stopPositions.push(groupedInd[i].pH2)\n                stopColors.push(groupedInd[i].color1);\n                stopColors.push(groupedInd[i].color2);\n            }\n            \n            var gradient = {\n                domain: [0,14],\n                stopPositions: stopPositions,\n                stops: stopColors,\n                stopType: 'values'\n            };\n            var scale = ColorBar.getColorScale(gradient);\n            var annotations = [];\n             for(var i=0; i<iter; i++) {\n                var phFrom = 14 * i/iter;\n                var phTo = 14 * (i+1)/iter;\n                var ph = (phFrom + phTo)/2;\n                var color = scale(ph);\n                annotations.push({\n                     color: color.color,\n                     value: phFrom + phTo / 2, \n                });\n            }\n             el.color = annotations;\n             el.indicator = indicators[k];\n             el.gradient = gradient;\n         }\n         API.createData('indicatorTable', indicatorTable);\n    });"]}],"libs":[[{"lib":"superagent","alias":"superagent"},{"lib":"papaparse","alias":"Papa"},{"lib":"lodash","alias":"_"},{"lib":"src/util/colorbar","alias":"ColorBar"}]],"buttons":[[{"name":"button1","label":"Execute","hide":[],"disable":[]}]]}},"layers":{"Default layer":{"position":{"left":113,"top":52},"size":{"width":65,"height":44},"zIndex":0,"display":false,"title":"Load indicator for google sheet","bgColor":[255,255,255,0],"wrapper":true,"created":true,"name":"Default layer"},"Admin":{"position":{"left":113,"top":52},"size":{"width":65,"height":79},"zIndex":0,"display":true,"title":"Load indicator for google sheet","bgColor":[255,255,255,0],"wrapper":true,"created":true,"na